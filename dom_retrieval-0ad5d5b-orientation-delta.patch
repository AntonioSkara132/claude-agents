diff --git a/poses.py b/poses.py
index 973a1a2..7790c67 100644
--- a/poses.py
+++ b/poses.py
@@ -7,6 +7,7 @@ import torch
 
 
 POSE_DIM = 14
+POSE_DELTA_DIM = 12
 
 
 def is_pose_trajectory(values: torch.Tensor) -> bool:
@@ -43,6 +44,79 @@ def project_pose_trajectory(values: torch.Tensor) -> torch.Tensor:
     return torch.cat((pose[..., :3], quaternions), dim=-1).reshape_as(values)
 
 
+def quaternion_multiply(first: torch.Tensor, second: torch.Tensor) -> torch.Tensor:
+    """Return the XYZW Hamilton product ``first * second``."""
+    if first.shape != second.shape or first.shape[-1] != 4:
+        raise ValueError("Quaternion operands must have matching [...,4] dimensions")
+    x1, y1, z1, w1 = first.unbind(-1)
+    x2, y2, z2, w2 = second.unbind(-1)
+    return torch.stack((
+        w1 * x2 + x1 * w2 + y1 * z2 - z1 * y2,
+        w1 * y2 - x1 * z2 + y1 * w2 + z1 * x2,
+        w1 * z2 + x1 * y2 - y1 * x2 + z1 * w2,
+        w1 * w2 - x1 * x2 - y1 * y2 - z1 * z2,
+    ), dim=-1)
+
+
+def quaternion_from_rotation_vector(rotation: torch.Tensor) -> torch.Tensor:
+    """Map rotation vectors to unit XYZW quaternions with a stable zero limit."""
+    if rotation.shape[-1] != 3 or not torch.isfinite(rotation).all():
+        raise ValueError("Rotation vectors must be finite [...,3] tensors")
+    theta = torch.linalg.vector_norm(rotation, dim=-1, keepdim=True)
+    half = theta * 0.5
+    factor = torch.where(theta < 1e-6, 0.5 - theta.square() / 48.,
+                         torch.sin(half) / theta.clamp_min(1e-8))
+    quaternion = torch.cat((rotation * factor, torch.cos(half)), dim=-1)
+    return quaternion / torch.linalg.vector_norm(quaternion, dim=-1, keepdim=True).clamp_min(1e-8)
+
+
+def current_tool_pose(observations: dict[str, torch.Tensor]) -> torch.Tensor:
+    """Return the measured current two-tool pose as [B,14]."""
+    if not isinstance(observations, dict):
+        raise ValueError("Orientation-delta output requires structured observations")
+    if "tool_positions" in observations and observations["tool_positions"].shape[-1] == POSE_DIM:
+        pose = observations["tool_positions"]
+    elif {"history_tool_positions", "history_mask"} <= observations.keys():
+        tools, mask = observations["history_tool_positions"], observations["history_mask"]
+        if tools.ndim != 3 or tools.shape[-1] != POSE_DIM or mask.shape != tools.shape[:2]:
+            raise ValueError("Temporal current pose must use [B,H,14] tool history")
+        rows = torch.arange(len(tools), device=tools.device)
+        pose = tools[rows, mask.sum(dim=1) - 1]
+    else:
+        raise ValueError("Orientation-delta output requires measured tool pose")
+    if pose.ndim != 2 or pose.shape[-1] != POSE_DIM or not pose.is_floating_point() or not torch.isfinite(pose).all():
+        raise ValueError("Measured current tool pose must be finite floating-point [B,14]")
+    values = pose.reshape(-1, 2, 7)
+    quaternions = normalize_quaternions(values[..., 3:])
+    return torch.cat((values[..., :3], quaternions), dim=-1).reshape_as(pose)
+
+
+def compose_orientation_delta(current: torch.Tensor, delta: torch.Tensor,
+                              positions: torch.Tensor | None = None) -> torch.Tensor:
+    """Decode [B,T,12] world-frame corrections into absolute [B,T,14] poses.
+
+    Each delta waypoint is ``[tool0_xyz, tool0_rotvec, tool1_xyz, tool1_rotvec]``.
+    Rotation uses the extrinsic convention ``q_delta * q_current``. If positions
+    is supplied it provides the absolute XYZ blocks; otherwise delta XYZ blocks
+    are returned as absolute positions.
+    """
+    if current.ndim != 2 or current.shape[-1] != POSE_DIM or delta.ndim != 3 or delta.shape[-1] != POSE_DELTA_DIM:
+        raise ValueError("Expected current [B,14] and delta [B,T,12]")
+    if len(current) != len(delta) or not torch.isfinite(delta).all():
+        raise ValueError("Current pose and delta batches must match and be finite")
+    if positions is None:
+        positions = delta[..., (0, 1, 2, 6, 7, 8)]
+    if positions.shape != delta.shape[:-1] + (6,):
+        raise ValueError("Absolute positions must have [B,T,6] dimensions")
+    base = current.reshape(-1, 2, 7)
+    current_q = base[..., 3:].unsqueeze(1).expand(-1, delta.shape[1], -1, -1)
+    values = delta.reshape(len(delta), delta.shape[1], 2, 6)
+    q_delta = quaternion_from_rotation_vector(values[..., 3:])
+    composed = quaternion_multiply(q_delta, current_q)
+    pose = torch.cat((positions.reshape(len(delta), delta.shape[1], 2, 3), composed), dim=-1)
+    return project_pose_trajectory(pose.reshape(len(delta), delta.shape[1], POSE_DIM))
+
+
 def position_channels(dimensions: int, device: torch.device | None = None) -> torch.Tensor | slice:
     if dimensions == 6:
         return slice(None)
