+    def test_orientation_delta_direct_and_retrieval_outputs(self) -> None:
+        q = torch.tensor([0., 0., 0., 1.])
+        pose = torch.cat((torch.zeros(3), q, torch.ones(3), q))
+        observations = {"observation": torch.randn(2, 12, 3),
+                       "tool_positions": pose.repeat(2, 1)}
+        frame = build_encoder({"kind": "pointnet", "embedding_dim": 8}, (12, 3))
+        encoder = ProprioceptiveEncoder(frame, embedding_dim=8, hidden_dim=16, pose_dim=14)
+        direct = DirectPolicy(encoder, 8, 14, embedding_dim=8, hidden_dim=16,
+                              pose_parameterization="orientation_delta")
+        output = direct(observations).prediction
+        self.assertEqual(tuple(output.shape), (2, 8, 14))
+        torch.testing.assert_close(output[..., 3:7], pose[None, None, 3:7].expand(2, 8, 4))
+        memory_demos = [Demonstration(str(i), f"g{i}", observations["observation"][0],
+                                      pose.repeat(8, 1), tool_positions=pose)
+                        for i in range(4)]
+        memory = MemoryBank(Split(memory_demos[:2], [memory_demos[2]], [memory_demos[3]]))
+        retrieval = RetrievalPolicy(encoder, memory, 8, 14, mode="cartesian", k=1,
+                                    embedding_dim=8, hidden_dim=16,
+                                    pose_parameterization="orientation_delta")
+        result = retrieval(observations, ["g2", "g2"]).prediction
+        self.assertEqual(tuple(result.shape), (2, 8, 14))
+        self.assertTrue(torch.isfinite(result).all())
