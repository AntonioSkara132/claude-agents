@@ -107,11 +107,14 @@ class RetrievalPolicy(nn.Module):
             reference = weighted_pose_mean(trajectories, retrieved.weights)
         reference = project_pose_trajectory(reference)
         if self.pose_parameterization == "orientation_delta":
+            if self.residual is None:
+                return PolicyOutput(prediction=reference, reference=reference,
+                                    raw_residual=reference.new_zeros(reference.shape[:-1] + (POSE_DELTA_DIM,)),
+                                    **({} if retrieved is None else vars(retrieved)))
             if not isinstance(observations, dict):
                 raise ValueError("Orientation delta requires structured observations")
-            delta = (self.residual(embedding) if self.residual_input == "observation" and self.residual is not None
-                     else self.residual(embedding, reference) if self.residual is not None
-                     else reference.new_zeros(reference.shape[:-1] + (POSE_DELTA_DIM,)))
+            delta = (self.residual(embedding) if self.residual_input == "observation"
+                     else self.residual(embedding, reference))
             reference_values = reference.reshape(*reference.shape[:-1], 2, 7)
             positions = reference_values[..., :3].reshape(reference.shape[0], reference.shape[1], 6)
             positions = positions + delta[..., (0, 1, 2, 6, 7, 8)]
